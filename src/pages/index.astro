---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Hero from '../components/Hero.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<BaseLayout title={site.title} description={site.intro}>
  <Hero />

  <section id="projects" class="section section--light" aria-labelledby="projects-heading">
    <div class="container">
      <SectionHeading
        id="projects-heading"
        title="Projects"
        subtext="Case studies of what I've built: the problem, the decisions and what broke along the way."
      />
      <div class="project-list">
        {projects.map((project, index) => <ProjectRow project={project} index={index} />)}
      </div>
    </div>
  </section>

  {/* Step 11 adds the #log section here */}

  <section id="contact" class="section section--dark" aria-labelledby="contact-heading">
    <div class="container">
      <SectionHeading
        id="contact-heading"
        title="Get in touch"
        subtext="Email me, read my code on GitHub or download my resume."
      />
      <ContactLinks />
    </div>
  </section>
</BaseLayout>

<style>
  .project-list {
    display: grid;
    gap: 56px;
  }

  @media (min-width: 768px) {
    .project-list {
      gap: 80px;
    }
  }
</style>
