---
// Temporary test page. Replaced by the real homepage in step 5.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={site.title} description={site.intro}>
  <div class="section section--dark">
    <div class="container">
      <h1>Heading 1 in Raleway 800</h1>
      <h2>Heading 2 in Raleway 800</h2>
      <h3>Heading 3 in Raleway 800</h3>
      <p>Body text in IBM Plex Mono 400.</p>
      <p><b>Body text in IBM Plex Mono 700.</b></p>
    </div>
  </div>
  <section class="section section--light">
    <div class="container">
      <h2>Light section</h2>
      <p>Body text on the light surface.</p>
      <p><a href="/">A focusable link</a></p>
    </div>
  </section>
</BaseLayout>
