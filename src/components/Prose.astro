---
// Reading styles for rendered Markdown. Colors derive from the surrounding text so it works on dark and light
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--prose-width);
    font-size: var(--fs-prose);
    line-height: var(--lh-prose);
  }

  .prose > :global(* + *) {
    margin-top: 1.25em;
  }

  .prose > :global(h2) {
    margin-top: 2.5em;
  }

  .prose > :global(h3) {
    margin-top: 2em;
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose > :global(h2 + *),
  .prose > :global(h3 + *) {
    margin-top: 0.75em;
  }

  .prose :global(a) {
    font-weight: 600;
    text-decoration-color: var(--color-primary-border);
    text-decoration-thickness: 2px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5em;
  }

  .prose :global(li + li) {
    margin-top: 0.5em;
  }

  .prose :global(img) {
    border-radius: var(--radius-card);
  }

  .prose :global(blockquote) {
    padding-left: 1em;
    border-left: 3px solid var(--color-primary-border);
  }

  .prose :global(code) {
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    background-color: color-mix(in srgb, currentColor 8%, transparent);
    border-radius: var(--radius-button);
  }

  .prose :global(pre) {
    padding: 16px;
    overflow-x: auto;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    border-radius: var(--radius-card);
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
</style>
